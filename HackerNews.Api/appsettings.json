{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Fatal",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Literate, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {TraceId}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "HackerNews": {
    "BaseAddress": "https://hacker-news.firebaseio.com/v0/",
    "CacheDuration": "01:00:00",
    "RefreshInterval": "00:55:00",
    "RetryInterval": "00:01:00",
    "MaxConcurrentRequests": 8
  },
  "RateLimiting": {
    "TokenLimit": 30,
    "TokensPerPeriod": 30,
    "ReplenishmentPeriod": "00:01:00"
  },
  "Telemetry": {
    "Enabled": true,
    "OtlpEndpoint": "http://localhost:4317"
  }
}
